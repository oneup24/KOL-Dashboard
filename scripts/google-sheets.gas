/**
 * FX Creations — KOL Dashboard backend (Google Sheets + Apps Script)
 * ============================================================================
 *
 * SETUP (once, ~3 minutes)
 * -----------------------
 * 1. Open your script at https://script.google.com and paste this whole file
 *    over Code.gs > Save.
 * 2. Deploy > New deployment > type "Web app" >
 *      Execute as:  Me
 *      Who has access: Anyone            <-- important, "Anyone" not "Anyone with Google account"
 *    Copy the Web app URL. It looks like:
 *      https://script.google.com/macros/s/AKfycbXXXXXXXX/exec
 *    (The URL from the script *editor* — /macros/library/... — is NOT this
 *    one. You need the URL from Deploy > New deployment.)
 * 3. Paste that URL into the dashboard: Settings > Google Sheets > Web app URL.
 *
 * The spreadsheet is handled automatically:
 *   - If you ran this from inside a Sheet, that Sheet is used.
 *   - Otherwise the script creates "FX Creations — KOL Dashboard" on first use
 *     and remembers it. The Settings page shows a link to it.
 *   - To point at a specific Sheet, set the SPREADSHEET_ID script property
 *     (Project Settings > Script Properties).
 *
 * You can run the `setup` function once from the editor to create the tabs
 * immediately instead of waiting for the first request.
 *
 * Every time you change the script you must Deploy > Manage deployments >
 * Edit > Version: New version, then re-deploy.
 *
 * TABS
 * ----
 *   Campaigns     one row per campaign
 *   KOLs          one row per KOL (the CRM master record)
 *   Applications  one row per campaign application
 *   MessageLog    one row per message sent to a KOL / the sales team
 *
 * HOW THE SHEET IS WRITTEN
 * ------------------------
 * The first row of each tab is the header. Rows are written by COLUMN NAME,
 * not by position, so the script is safe to run against a sheet that already
 * has data in a different column order.
 *
 *   - Scalar fields get their own column so the sheet stays readable.
 *   - Arrays and objects are stored as JSON text in a single column.
 *   - Any field the script does not know about is preserved in the trailing
 *     `extra` JSON column, so a new field in the app never silently drops data.
 *   - If a tab is missing a column, it is appended — existing rows keep their
 *     data and their column positions.
 */

const TABS = {
  campaigns: "Campaigns",
  kols: "KOLs",
  applications: "Applications",
  messageLog: "MessageLog",
};

/**
 * The columns each tab should have.
 *   simple: written verbatim into its own cell
 *   json:   written as JSON text into a single cell
 */
const SCHEMA = {
  campaigns: {
    simple: [
      "id", "slug", "name", "status", "platform", "region", "manager",
      "budget", "totalBudget",
      "targetKolCount", "maxApplications", "campaignCode",
      "applicationDeadline", "postStartDate", "postEndDate", "endDate",
      "progress", "kols",
      "productName", "productUrl", "productImage", "productDescription",
      "campaignBrief", "disclosureText", "briefDocUrl", "language",
      "feeModel", "feePerKol", "commissionPct",
      "feeDisplayEnabled", "feeDisplayText",
      "promoCodeTemplate", "promoCodeValue",
      "updatedAt",
    ],
    json: [
      "platforms", "deliverables", "requirements", "mandatoryTags",
      "mandatoryMentions", "audience", "variants", "storeIds", "kolTiers",
      "customQuestions",
    ],
    // Columns holding true/false. A sheet stores everything as text, so
    // these are read back as real booleans — otherwise the string "false"
    // would be truthy and flip the flag the wrong way.
    bools: ["feeDisplayEnabled"],
  },
  kols: {
    simple: [
      "id", "name", "handle", "primaryPlatform", "followers", "er",
      "whatsapp", "email", "igHandle", "region", "tier", "rateCard",
      "source", "status", "rating", "dateAdded", "lastContactedAt", "avatar",
    ],
    json: ["platforms", "niches", "tags", "notes", "posts"],
  },
  applications: {
    simple: [
      "id", "campaignId", "kolId", "status",
      "appliedAt", "updatedAt",
      "pickupStoreId", "variantId", "notes", "internalNotes",
      "reviewedAt", "approvedAt", "rejectedAt", "rejectReason",
      "productReadyAt", "pickedUpAt", "briefSentAt", "contentLiveAt",
      "completedAt",
      "promoCode", "discountValue",
      "postUrl", "postPlatform", "postDate", "postType", "paid",
    ],
    json: ["postMetrics", "customAnswers"],
    bools: ["paid"],
  },
  messageLog: {
    simple: [
      "id", "templateId", "applicationId", "recipient", "channel",
      "renderedBody", "sentAt", "sentBy",
    ],
    json: [],
  },
};

/* ── sheet helpers ──────────────────────────────────────────────────────── */

/** The column names a tab should have, in canonical order. */
function wantedColumns(entity) {
  const spec = SCHEMA[entity] || { simple: [], json: [] };
  return spec.simple.concat(spec.json).concat(["extra"]);
}

/**
 * Resolves the spreadsheet this script writes to.
 *
 * Order of preference:
 *   1. The SPREADSHEET_ID script property (always wins — set it if you want
 *      to point the script at a specific Sheet).
 *   2. The Sheet this script is bound to (Extensions > Apps Script from
 *      inside the Sheet).
 *   3. A brand new Sheet, created on first use. The id is remembered in the
 *      script properties so the next run reuses it.
 *
 * That third option means a standalone script works with zero configuration.
 */
function getSpreadsheet() {
  const props = PropertiesService.getScriptProperties();
  const id = props.getProperty("SPREADSHEET_ID");
  if (id) return SpreadsheetApp.openById(id);

  const active = SpreadsheetApp.getActiveSpreadsheet();
  if (active) {
    props.setProperty("SPREADSHEET_ID", active.getId());
    return active;
  }

  const created = SpreadsheetApp.create("FX Creations — KOL Dashboard");
  props.setProperty("SPREADSHEET_ID", created.getId());
  return created;
}

/** True when the tab holds at least one record (not just a header). */
function hasRecords(sheet) {
  if (sheet.getLastRow() < 2) return false;
  const ids = sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getValues();
  return ids.some(function (row) { return row[0] !== "" && row[0] !== null; });
}

/** The current header of a tab, as an array of column names. */
function headerOf(sheet) {
  if (sheet.getLastColumn() < 1) return [];
  return sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
}

/**
 * Appends any missing column to the tab and returns the resulting header.
 * Existing columns keep their position, so data already in the sheet is
 * never shifted.
 */
function ensureColumns(sheet, entity) {
  const wanted = wantedColumns(entity);
  const header = headerOf(sheet);
  const missing = wanted.filter(function (name) {
    return header.indexOf(name) === -1;
  });
  if (missing.length > 0) {
    // Insert right after the last used column so no gap opens up in the
    // sheet and the existing rows keep their positions.
    const after = sheet.getLastColumn();
    sheet.insertColumnsAfter(after, missing.length);
    sheet.getRange(1, after + 1, 1, missing.length).setValues([missing]);
  }
  return headerOf(sheet);
}

/** Returns the tab, creating it with the canonical header if it is missing. */
function tabSheet(entity) {
  const ss = getSpreadsheet();
  const tab = TABS[entity] || entity;
  let sheet = ss.getSheetByName(tab);
  if (!sheet) {
    sheet = ss.insertSheet(tab);
    const wanted = wantedColumns(entity);
    sheet.getRange(1, 1, 1, wanted.length).setValues([wanted]);
    sheet.setFrozenRows(1);
    return sheet;
  }
  ensureColumns(sheet, entity);
  return sheet;
}

/* ── setup ──────────────────────────────────────────────────────────────── */

/**
 * Creates the four tabs.
 *
 * Safe to run more than once. A tab that already holds data keeps its
 * existing columns — new columns are appended rather than inserted, so
 * nothing already in the sheet shifts.
 */
function setup() {
  const ss = getSpreadsheet();
  Object.keys(TABS).forEach(function (entity) {
    const tab = TABS[entity];
    let sheet = ss.getSheetByName(tab);
    const wanted = wantedColumns(entity);

    if (!sheet) {
      sheet = ss.insertSheet(tab);
      sheet.getRange(1, 1, 1, wanted.length).setValues([wanted]);
      sheet.setFrozenRows(1);
      return;
    }

    if (!hasRecords(sheet)) {
      // Empty tab — write the canonical header.
      sheet.getRange(1, 1, 1, wanted.length).setValues([wanted]);
      sheet.setFrozenRows(1);
      return;
    }

    // Tab already has data — only append the columns it is missing.
    ensureColumns(sheet, entity);
  });
  return (
    "Tabs ready: " +
    Object.keys(TABS)
      .map(function (e) { return TABS[e]; })
      .join(", ")
  );
}

/* ── read ──────────────────────────────────────────────────────────────── */

function readAll() {
  const out = {};
  Object.keys(TABS).forEach(function (entity) {
    out[entity] = readEntity(entity);
  });
  return out;
}

function readEntity(entity) {
  const sheet = tabSheet(entity);
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return [];
  const header = headerOf(sheet);
  if (!header.length) return [];
  const rows = sheet.getRange(2, 1, lastRow - 1, header.length).getValues();
  const spec = SCHEMA[entity] || { simple: [], json: [] };
  const jsonCols = {};
  spec.json.forEach(function (k) { jsonCols[k] = true; });
  const boolCols = {};
  (spec.bools || []).forEach(function (k) { boolCols[k] = true; });

  const records = [];
  for (let r = 0; r < rows.length; r++) {
    const row = rows[r];
    if (!row[0]) continue;
    const record = {};
    let extra = {};
    for (let c = 0; c < header.length; c++) {
      const key = header[c];
      if (!key) continue;
      const cell = row[c];
      if (key === "extra") {
        if (cell) {
          try { extra = JSON.parse(cell); } catch (err) { extra = {}; }
        }
        continue;
      }
      if (jsonCols[key]) {
        if (cell) {
          try { record[key] = JSON.parse(cell); } catch (err) { record[key] = null; }
        }
        continue;
      }
      if (boolCols[key]) {
        record[key] = cell === "" ? null : String(cell).toLowerCase() === "true";
        continue;
      }
      record[key] = cell === "" ? null : cell;
    }
    records.push(Object.assign(extra, record));
  }
  return records;
}

/* ── write ─────────────────────────────────────────────────────────────── */

/**
 * Builds the row to write, following the SHEET's own header order rather
 * than the canonical order. Fields the sheet has no column for are collected
 * into the trailing `extra` cell.
 */
function toRow(entity, record, header) {
  const spec = SCHEMA[entity] || { simple: [], json: [] };
  const jsonCols = {};
  spec.json.forEach(function (k) { jsonCols[k] = true; });
  const known = {};
  spec.simple.concat(spec.json).forEach(function (k) { known[k] = true; });

  const extra = {};
  Object.keys(record).forEach(function (key) {
    if (known[key]) return;
    const v = record[key];
    if (v === undefined || v === null) return;
    extra[key] = v;
  });
  const extraCell = Object.keys(extra).length ? JSON.stringify(extra) : "";

  return header.map(function (key) {
    if (key === "extra") return extraCell;
    const v = record[key];
    if (v === undefined || v === null) return "";
    if (jsonCols[key]) return typeof v === "string" ? v : JSON.stringify(v);
    return String(v);
  });
}

function upsert(entity, record) {
  const sheet = tabSheet(entity);
  const id = record.id;
  if (id === undefined || id === null) throw new Error("Record has no id");

  const header = ensureColumns(sheet, entity);
  const row = toRow(entity, record, header);

  const idCol = header.indexOf("id") + 1;
  if (idCol < 1) throw new Error("No id column in " + (TABS[entity] || entity));

  const lastRow = sheet.getLastRow();
  if (lastRow >= 2) {
    const ids = sheet.getRange(2, idCol, lastRow - 1, 1).getValues();
    for (let i = 0; i < ids.length; i++) {
      if (String(ids[i][0]) === String(id)) {
        sheet.getRange(i + 2, 1, 1, row.length).setValues([row]);
        return { ok: true, action: "updated" };
      }
    }
  }
  sheet.getRange(lastRow + 1, 1, 1, row.length).setValues([row]);
  return { ok: true, action: "created" };
}

function remove(entity, id) {
  const sheet = tabSheet(entity);
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return { ok: true, removed: 0 };
  const header = headerOf(sheet);
  const idCol = header.indexOf("id") + 1;
  if (idCol < 1) return { ok: true, removed: 0 };
  const ids = sheet.getRange(2, idCol, lastRow - 1, 1).getValues();
  let removed = 0;
  for (let i = ids.length - 1; i >= 0; i--) {
    if (String(ids[i][0]) === String(id)) {
      sheet.deleteRow(i + 2);
      removed++;
    }
  }
  return { ok: true, removed: removed };
}

/* ── web app entry points ──────────────────────────────────────────────── */

function doGet(e) {
  try {
    const action = (e && e.parameter && e.parameter.action) || "read";
    if (action === "health") {
      const ss = getSpreadsheet();
      return json({
        ok: true,
        spreadsheet: ss.getName(),
        spreadsheetId: ss.getId(),
        spreadsheetUrl: ss.getUrl(),
        tabs: Object.keys(TABS),
      });
    }
    if (action === "setup") {
      return json({ ok: true, message: setup() });
    }
    return json({ ok: true, data: readAll() });
  } catch (err) {
    return json({ ok: false, error: String(err && err.message ? err.message : err) });
  }
}

function doPost(e) {
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(20000);
    const body = JSON.parse((e && e.postData && e.postData.contents) || "{}");
    const action = body.action || "upsert";

    if (action === "upsert") {
      return json(upsert(body.entity, body.record));
    }
    if (action === "delete") {
      return json(remove(body.entity, body.id));
    }
    if (action === "bulk") {
      const records = body.records || [];
      let count = 0;
      for (let i = 0; i < records.length; i++) {
        upsert(body.entity, records[i]);
        count++;
      }
      return json({ ok: true, count: count });
    }
    return json({ ok: false, error: "Unknown action: " + action });
  } catch (err) {
    return json({ ok: false, error: String(err && err.message ? err.message : err) });
  }
}

function json(payload) {
  return ContentService.createTextOutput(JSON.stringify(payload)).setMimeType(
    ContentService.MimeType.JSON,
  );
}
